<Page x:Class="BimAgenticBridge.UI.ChatPanel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F7F7F7">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,8">
      <TextBlock Text="BIM Agentic Bridge"
                 FontSize="16"
                 FontWeight="SemiBold" />
      <TextBlock Text="Ask about rooms, levels, doors, and windows"
                 FontSize="11"
                 Foreground="#666666"
                 Margin="0,2,0,0" />
    </StackPanel>

    <ListBox Grid.Row="1"
             x:Name="MessageList"
             ItemsSource="{Binding Messages}"
             DisplayMemberPath="DisplayText"
             BorderBrush="#CCCCCC"
             BorderThickness="1"
             Background="White"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.VerticalScrollBarVisibility="Auto" />

    <Grid Grid.Row="2" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBox Grid.Column="0"
               Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
               Height="28"
               VerticalContentAlignment="Center"
               KeyDown="InputBox_KeyDown" />

      <Button Grid.Column="1"
              Content="Send"
              Width="72"
              Margin="8,0,0,0"
              Height="28"
              Command="{Binding SendCommand}" />
    </Grid>

    <TextBlock Grid.Row="3"
               Margin="0,8,0,0"
               FontSize="10"
               Foreground="#888888"
               Text="by Athis J · github.com/codewithathis"
               ToolTip="https://github.com/codewithathis" />
  </Grid>
</Page>
