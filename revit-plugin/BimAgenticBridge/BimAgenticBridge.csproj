<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>BimAgenticBridge</RootNamespace>
    <AssemblyName>BimAgenticBridge</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <PlatformTarget>x64</PlatformTarget>
    <Authors>Athis J</Authors>
    <Company>Athis J</Company>
    <Product>BIM Agentic Bridge</Product>
    <Description>AI-powered BIM room assessment bridge for Autodesk Revit. Author: Athis J - https://github.com/codewithathis</Description>
    <Copyright>Copyright (c) Athis J 2026</Copyright>
    <PackageProjectUrl>https://github.com/codewithathis</PackageProjectUrl>
    <RepositoryUrl>https://github.com/codewithathis</RepositoryUrl>
    <Version>1.0.0</Version>
    <!-- RevitAPI brings older assembly versions; suppress noisy binding redirects at compile time. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <RevitInstallPath Condition="'$(RevitInstallPath)' == ''">D:\Development\Autodesk\Revit 2027</RevitInstallPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallPath)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallPath)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- Revit locks the output DLL while running; fail fast with a clear message. -->
  <Target Name="EnsureRevitIsNotLockingOutput" BeforeTargets="BeforeBuild">
    <Exec
      Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;if (Get-Process -Name 'Revit' -ErrorAction SilentlyContinue) { Write-Host 'ERROR: Autodesk Revit is running and locks BimAgenticBridge.dll. Close Revit, then rebuild.' -ForegroundColor Red; exit 1 }&quot;"
      IgnoreExitCode="false" />
  </Target>
</Project>
