# gemini | openai
LLM_PROVIDER=gemini

GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
# Use Vertex AI with Application Default Credentials (Cloud Run / gcloud ADC)
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Leave empty to use %LOCALAPPDATA%\BimAgenticBridge\data.json (must match Revit plugin)
DATA_JSON_PATH=
DATA_TTL_SECONDS=300
API_HOST=127.0.0.1
API_PORT=8000
